APP_ENV=development
SECRET_KEY=change-me-in-production
DATABASE_URL=postgresql+asyncpg://operator:operator@postgres:5432/operator
REDIS_URL=redis://redis:6379/0
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=operator
STORAGE_SECRET_KEY=operator-secret
STORAGE_BUCKET=documents
ERP_MODE=demo
# Modos de execução: demo (simulado) | csv (exporta arquivo) | manual (bloqueia automação) | http (conector REST genérico)
# Conector HTTP genérico (ERP_MODE=http): configure abaixo
ERP_HTTP_BASE_URL=
ERP_HTTP_TOKEN=
ERP_HTTP_AUTH_HEADER=Authorization
ERP_HTTP_AUTH_SCHEME=Bearer
ERP_HTTP_CREATE_PATH=/orders
ERP_HTTP_VERIFY_PATH=/orders/{external_id}
ERP_HTTP_PAYLOAD={"reference":{reference},"supplier":{supplier},"tax_id":{tax_id},"due_date":{due_date},"cost_center":{cost_center},"total":{total},"idempotency_key":{idempotency_key},"items":{items}}
ERP_HTTP_ITEM_FIELDS={}
ERP_HTTP_EXTERNAL_ID_PATH=id
ERP_HTTP_TIMEOUT=10
ERP_HTTP_RETRIES=2
MAX_UPLOAD_MB=10
# Extração: none = só heurística. Para LLM use openai (compatível com OpenAI/Groq/OpenRouter/LM Studio).
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
